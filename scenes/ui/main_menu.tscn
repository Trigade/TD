[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/main_menu.gd" id="1_menu"]
[ext_resource type="Script" path="res://scripts/map/space_background.gd" id="2_bg"]

[node name="MainMenu" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Background" type="Node2D" parent="."]
script = ExtResource("2_bg")

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Content" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 28

[node name="Title" type="Label" parent="Center/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.5, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 12
theme_override_font_sizes/font_size = 110
text = "CARINAE"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 28
text = "Eta Carinae istasyonunu nebuladan gelen dalgalara karşı savun"
horizontal_alignment = 1

[node name="Buttons" type="VBoxContainer" parent="Center/Content"]
custom_minimum_size = Vector2(360, 0)
layout_mode = 2
theme_override_constants/separation = 14

[node name="Play" type="Button" parent="Center/Content/Buttons"]
layout_mode = 2
theme_override_font_sizes/font_size = 34
text = "Oyna"

[node name="Quit" type="Button" parent="Center/Content/Buttons"]
layout_mode = 2
theme_override_font_sizes/font_size = 34
text = "Çıkış"
