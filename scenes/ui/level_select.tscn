[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/level_select.gd" id="1_select"]
[ext_resource type="Script" path="res://scripts/map/space_background.gd" id="2_bg"]

[node name="LevelSelect" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_select")

[node name="Background" type="Node2D" parent="."]
script = ExtResource("2_bg")

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Content" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Center/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.5, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 10
theme_override_font_sizes/font_size = 64
text = "Bölüm Seç"
horizontal_alignment = 1

[node name="Levels" type="VBoxContainer" parent="Center/Content"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Back" type="Button" parent="Center/Content"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 28
text = "Geri"
